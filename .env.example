# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Optional: GitHub personal access token for higher API rate limits
# (unauthenticated: 60 req/hr, authenticated: 5000 req/hr)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: override the GitHub username at runtime
# NUXT_PUBLIC_GITHUB_USERNAME=mattpolicastro

# A/B testing — set in CI via repo secrets of the same name
# NUXT_PUBLIC_MIDA_PROJECT_KEY=xxxxxxxx
